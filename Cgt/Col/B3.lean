import Cgt.Col.Sound
import Cgt.Col.B3Blocks
import Cgt.Basic
import Cgt.FamilyA1

/-!
# The column `b = 3`: `Tᵃ □³ Fᵃ` is infinitesimal for every `a`

The 382 + 2,649 keys of `Cgt/Col/B3Data.lean` pass the finite check (`hcU`, `hcN`, evaluated by
the kernel in chunks in `Cgt/Col/B3Check*.lean` and assembled in `Cgt/Col/B3Blocks.lean`, both
generated by `scripts/gen_col_chunks.py`), and the start `Tᵃ□³Fᵃ` has its key in the Left-stop tree for every `a ≥ 2` (`key_s3`).
With the soundness theorem `sound`, this gives Left stop `≤ 0` for every start, hence
infinitesimality.
-/

namespace Cgt
namespace Col
open Cell TF Game

theorem hcU : ∀ k ∈ colB3U.toList, ∀ W ∈ witOf k, chkU colB3U colB3N W = true := by
  have h : colB3U.toList.all (fun k => (witOf k).all (chkU colB3U colB3N)) = true :=
    all_of_sizes _ [287, 82, 13] _ (by decide +kernel) fun i hi => by
      match i, hi with
      | 0, _ => exact blkB3U_0
      | 1, _ => exact blkB3U_1
      | 2, _ => exact blkB3U_2
      | _ + 3, h => exact absurd h (by simp)
  simp only [List.all_eq_true] at h
  exact h

theorem hcN : ∀ k ∈ colB3N.toList, ∀ W ∈ witOf k, chkN colB3N W = true := by
  have h : colB3N.toList.all (fun k => (witOf k).all (chkN colB3N)) = true :=
    all_of_sizes _ [1103, 411, 375, 189, 243, 77, 251] _ (by decide +kernel) fun i hi => by
      match i, hi with
      | 0, _ => exact blkB3N_3
      | 1, _ => exact blkB3N_4
      | 2, _ => exact blkB3N_5
      | 3, _ => exact blkB3N_6
      | 4, _ => exact blkB3N_7
      | 5, _ => exact blkB3N_8
      | 6, _ => exact blkB3N_9
      | _ + 7, h => exact absurd h (by simp)
  simp only [List.all_eq_true] at h
  exact h

/-- `Tᵃ □³ Fᵃ` as a run list. -/
def s3 (a : Nat) : RL := [(T, a), (E, 3), (F, a)]

theorem expand_s3 (a : Nat) : expand (s3 a) = start a 3 := by
  simp [s3, start]

theorem maxB_s3 {a : Nat} (ha : 1 ≤ a) : maxB (s3 a) = true := by
  simp [s3, maxB, okFrom, ha]

theorem lenAt_s3 (a i : Nat) : lenAt (s3 a) i = if i = 0 ∨ i = 2 then a else if i = 1 then 3 else 0 := by
  match i with
  | 0 => rfl
  | 1 => rfl
  | 2 => rfl
  | i + 3 => simp [lenAt, runAt, s3, List.getD]

theorem cellAt_s3 (a i : Nat) : cellAt (s3 a) i = cellAt (s3 (a + 2)) i := by
  match i with
  | 0 => rfl
  | 1 => rfl
  | 2 => rfl
  | i + 3 => simp [cellAt, runAt, s3, List.getD]

/-- Beyond `a = 6`, the start keys repeat with period 2. -/
theorem rel_s3 {a : Nat} (ha : 6 ≤ a) : Rel 0 (s3 a) (s3 (a + 2)) := by
  refine ⟨⟨rfl, fun i => ⟨cellAt_s3 a i, ?_, ?_⟩⟩, fun i _ => ?_, fun i k _ _ => ?_⟩
  · rw [lenAt_s3, lenAt_s3]; split <;> (try split) <;> omega
  · intro h; rw [lenAt_s3, lenAt_s3]
    match i with
    | 0 => simp [cellAt, runAt, s3] at h
    | 1 => rfl
    | 2 => simp [cellAt, runAt, s3] at h
    | i + 3 => simp
  · rw [lenAt_s3, lenAt_s3]; unfold close
    split <;> (try split) <;> omega
  · rw [lenAt_s3, lenAt_s3, lenAt_s3, lenAt_s3]; unfold close
    split <;> split <;> (try split) <;> (try split) <;> omega

theorem key_s3 : ∀ a, 2 ≤ a → colB3U.mem (keyOf (s3 a)) = true
  | 2, _ => by decide +kernel
  | 3, _ => by decide +kernel
  | 4, _ => by decide +kernel
  | 5, _ => by decide +kernel
  | 6, _ => by decide +kernel
  | 7, _ => by decide +kernel
  | a + 8, _ => by
    rw [← keyOf_eq_of_rel (rel_s3 (a := a + 6) (by omega))]
    exact key_s3 (a + 6) (by omega)

/-- **The column `b = 3`, given the margin lemmas.** -/
theorem infinitesimal_start_three_of (hm : Margin) (a : Nat) : Infinitesimal (tf (start a 3)) := by
  match a with
  | 0 => exact infinitesimal_start_a_zero 3
  | 1 => exact infinitesimal_start_one 3
  | a + 2 =>
    rw [infinitesimal_start_iff, ← expand_s3]
    exact (sound hm colB3U colB3N hcU hcN _ (s3 (a + 2)) (maxB_s3 (by omega)) (Nat.lt_succ_self _)).2
      (key_s3 (a + 2) (by omega))

end Col
end Cgt
