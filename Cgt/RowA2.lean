import Cgt.RowA2Data
import Cgt.Basic
import Cgt.FamilyB1

/-!
# The row `a = 2`: `TT □ᵇ FF` is infinitesimal for every `b`

For `b ≥ 2`, Left's only move from `TT□ᵇFF` leads to `T□T□ᵇ⁻¹FF`, and that position is `≤ 0`:
Right, moving second, wins it in normal play. So Right answers Left's move by passing, and
`TT□ᵇFF` (which is symmetric) has Left stop `≤ 0`.

`T□T□ᵐFF ≤ 0` for all `m ≥ 1` comes from `le_zero_of_good`: the 1,543 shapes in `treeA2`
(generated by `scripts/gen_row2.py`) pass the finite check `checkAll`, and the shape of
`T□T□ᵐFF` is among them for every `m ≥ 1`.
-/

namespace Cgt
open Cell TF Game

local notation "rep" => List.replicate

/-- The finite check, evaluated by the kernel. -/
theorem checkA2 : checkAll treeA2 = true := by decide +kernel

/-- `T□T□ᵐFF`. -/
def q2 (m : Nat) : P4 := ⟨true, true, false, false, 0, 1, m, 0, 0⟩

theorem good_q2 (m : Nat) (hm : 1 ≤ m) : good treeA2 (q2 m) = true := by
  have hs : (q2 m).shape = ⟨44, 0, -1, 0, 0, cap m⟩ := rfl
  simp only [good, hs]
  have : cap m = 1 ∨ cap m = 2 ∨ cap m = 3 ∨ cap m = 4 ∨ cap m = 5 := by
    unfold cap K4
    by_cases h : m < 4 <;> simp only [h, ite_true, ite_false] <;> omega
  rcases this with h | h | h | h | h <;> rw [h] <;> decide

/-- `T□T□ᵐFF ≤ 0`: Right, moving second, wins it. -/
theorem q2_le_zero (m : Nat) (hm : 1 ≤ m) : le (tf (q2 m).toList) zero :=
  le_zero_of_good treeA2 checkA2 _ (q2 m) (Nat.lt_succ_self _) (good_q2 m hm)

/-- `TT□ᵐ⁺¹FF` as a four-piece position. -/
def s2 (m : Nat) : P4 := ⟨true, true, false, false, 0, 0, m + 1, 0, 0⟩

theorem start_two_eq (m : Nat) : start 2 (m + 1) = (s2 m).toList := by
  simp [start, s2, P4.toList, pc]

theorem lms_s2 (m : Nat) : (s2 m).lms = [q2 m] := by
  simp [P4.lms, P4.lm1, P4.lm2, P4.lm3, P4.lm4, s2, q2]

theorem upperZero_start_two (m : Nat) (hm : 1 ≤ m) : UpperZero (tf (start 2 (m + 1))) := by
  rw [upperZero_tf_iff]
  refine ⟨lfZero_of_mirror (mirror_start 2 (m + 1)), ?_⟩
  intro q hq
  rw [start_two_eq, leftMoves_toList, lms_s2] at hq
  simp only [List.map_cons, List.map_nil, List.mem_singleton] at hq
  subst hq
  rw [lfZero_tf_iff]
  exact Or.inl (q2_le_zero m hm)

/-- **The row `a = 2`.** `TT□ᵇFF` is infinitesimal for every `b`. -/
theorem infinitesimal_start_two (b : Nat) : Infinitesimal (tf (start 2 b)) := by
  match b with
  | 0 => exact infinitesimal_start_b_zero 2
  | 1 => exact infinitesimal_start_b_one 2
  | m + 2 =>
    rw [infinitesimal_start_iff]
    exact upperZero_start_two (m + 1) (by omega)

end Cgt
