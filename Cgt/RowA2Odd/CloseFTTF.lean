theorem cl_FTTF_2_jump (g0 g1 g2 g3 g4 : Nat) (h : goodFTTF g0 g1 g2 g3 g4) (hc : g3 = 0) (hc' : g4 ≠ 0) :
    ∃ r, r ∈ (⟨false, true, false, true, g0, g1, g2 + 1, g3, g4 - 1⟩ : P4).rms ∧ inv2 r := by
  unfold goodFTTF at h
  rcases h with h | h | h | h | h | h | h | h
  · exact cl_FTTF_2_jump_0 g0 g1 g2 g3 g4 h hc hc'
  · exact cl_FTTF_2_jump_1 g0 g1 g2 g3 g4 h hc hc'
  · exact cl_FTTF_2_jump_2 g0 g1 g2 g3 g4 h hc hc'
  · exact cl_FTTF_2_jump_3 g0 g1 g2 g3 g4 h hc hc'
  · exact cl_FTTF_2_jump_4 g0 g1 g2 g3 g4 h hc hc'
  · exact cl_FTTF_2_jump_5 g0 g1 g2 g3 g4 h hc hc'
  · exact cl_FTTF_2_jump_6 g0 g1 g2 g3 g4 h hc hc'
  · exact cl_FTTF_2_jump_7 g0 g1 g2 g3 g4 h hc hc'

theorem close_FTTF (g0 g1 g2 g3 g4 : Nat) (h : goodFTTF g0 g1 g2 g3 g4) (q : P4)
    (hq : q ∈ (⟨false, true, true, false, g0, g1, g2, g3, g4⟩ : P4).lms) : ∃ r, r ∈ q.rms ∧ inv2 r := by
  rcases mem_lms.1 hq with e | e | e | e
  · -- piece 1
    simp [P4.lm1] at e
  · -- piece 2
    by_cases z : g2 = 0
    · simp [P4.lm2, z] at e
    · rw [lm2_slide z] at e; cases e; exact cl_FTTF_1_slide g0 g1 g2 g3 g4 h z
  · -- piece 3
    by_cases z : g3 = 0
    · by_cases z' : g4 = 0
      · simp [P4.lm3, z, z'] at e
      · rw [lm3_jump z z'] at e; cases e; exact cl_FTTF_2_jump g0 g1 g2 g3 g4 h z z'
    · rw [lm3_slide z] at e; cases e; exact cl_FTTF_2_slide g0 g1 g2 g3 g4 h z
  · -- piece 4
    simp [P4.lm4] at e

