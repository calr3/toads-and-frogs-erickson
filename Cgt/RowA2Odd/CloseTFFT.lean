theorem cl_TFFT_3_slide (g0 g1 g2 g3 g4 : Nat) (h : goodTFFT g0 g1 g2 g3 g4) (hc : g4 ≠ 0) :
    ∃ r, r ∈ (⟨true, false, false, true, g0, g1, g2, g3 + 1, g4 - 1⟩ : P4).rms ∧ inv2 r := by
  unfold goodTFFT at h
  rcases h with h | h | h | h | h | h | h | h | h | h | h | h | h | h
  · exact cl_TFFT_3_slide_0 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_1 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_2 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_3 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_4 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_5 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_6 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_7 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_8 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_9 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_10 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_11 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_12 g0 g1 g2 g3 g4 h hc
  · exact cl_TFFT_3_slide_13 g0 g1 g2 g3 g4 h hc

theorem close_TFFT (g0 g1 g2 g3 g4 : Nat) (h : goodTFFT g0 g1 g2 g3 g4) (q : P4)
    (hq : q ∈ (⟨true, false, false, true, g0, g1, g2, g3, g4⟩ : P4).lms) : ∃ r, r ∈ q.rms ∧ inv2 r := by
  rcases mem_lms.1 hq with e | e | e | e
  · -- piece 1
    by_cases z : g1 = 0
    · by_cases z' : g2 = 0
      · simp [P4.lm1, z, z'] at e
      · rw [lm1_jump z z'] at e; cases e; exact cl_TFFT_0_jump g0 g1 g2 g3 g4 h z z'
    · rw [lm1_slide z] at e; cases e; exact cl_TFFT_0_slide g0 g1 g2 g3 g4 h z
  · -- piece 2
    simp [P4.lm2] at e
  · -- piece 3
    simp [P4.lm3] at e
  · -- piece 4
    by_cases z : g4 = 0
    · simp [P4.lm4, z] at e
    · rw [lm4_slide z] at e; cases e; exact cl_TFFT_3_slide g0 g1 g2 g3 g4 h z

