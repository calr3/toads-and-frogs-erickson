  ∨ ((-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) ≥ -2) ∧ (-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) ≤ 0) ∧ ((g0:Int) + (g1:Int) + (g2:Int) - (g4:Int) ≥ 2))
  ∨ ((-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) = 0) ∧ ((g0:Int) + (g1:Int) + (g2:Int) - (g4:Int) ≤ 1) ∧ (((g0:Int) - 2 * (g2:Int) - (g4:Int)) % 3 = 0) ∧ ((g1:Int) - 2 * (g2:Int) + (g4:Int) = 0))
  ∨ ((-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) ≤ 0) ∧ ((g0:Int) + (g1:Int) + (g2:Int) - (g4:Int) = 1) ∧ (((g0:Int) - 2 * (g2:Int) - (g4:Int)) % 3 ≠ 0))

/-- `FTFT`: 3 cases. -/
def goodFTFT (g0 g1 g2 g3 g4 : Nat) : Prop :=
  ((-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) ≥ 0) ∧ (-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) ≤ 1) ∧ ((g1:Int) - (g3:Int) ≤ 0) ∧ ((g1:Int) - (g3:Int) ≥ -1) ∧ (((g2:Int) - 2 * (g3:Int) - 2 * (g4:Int)) % 2 = 0))
  ∨ ((-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) ≥ 0) ∧ (-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) ≤ 1) ∧ ((g1:Int) - (g3:Int) ≤ -2))
  ∨ ((-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) ≥ -3) ∧ (-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) ≤ -1))

/-- `FFTT`: 1 cases. -/
def goodFFTT (g0 g1 g2 g3 g4 : Nat) : Prop :=
  ((-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) ≥ -4) ∧ (-2 * (g0:Int) - (g1:Int) + (g3:Int) + 2 * (g4:Int) ≤ 0))

/-- The invariant: Right, moving second, wins every position satisfying it. -/
def inv2 : P4 → Prop
  | ⟨true, true, false, false, g0, g1, g2, g3, g4⟩ => goodTTFF g0 g1 g2 g3 g4
  | ⟨true, false, true, false, g0, g1, g2, g3, g4⟩ => goodTFTF g0 g1 g2 g3 g4
  | ⟨false, true, true, false, g0, g1, g2, g3, g4⟩ => goodFTTF g0 g1 g2 g3 g4
  | ⟨true, false, false, true, g0, g1, g2, g3, g4⟩ => goodTFFT g0 g1 g2 g3 g4
  | ⟨false, true, false, true, g0, g1, g2, g3, g4⟩ => goodFTFT g0 g1 g2 g3 g4
  | ⟨false, false, true, true, g0, g1, g2, g3, g4⟩ => goodFFTT g0 g1 g2 g3 g4
  | _ => False

end Cgt
