import Cgt.RowA2ZeroData
import Cgt.RowA2

/-!
# Exact values in the row `a = 2`: `TT □ᵇ FF = 0` for even `b ≥ 6`

`TT□ᵇFF` is symmetric, so it is `0` as soon as it is `≤ 0`. Left's only move leads to
`T□T□ᵇ⁻¹FF`, and Right answers with the frog move to `T□T□ᵇ⁻²F□F`. For even `b ≥ 6`, that
position is `≤ 0`: the 1,038 shapes in `treeA2Zero` (generated by `scripts/search_row2.py
zero_even 2 4 4`) pass `checkAll`, and the shape of `T□T□ᵏF□F` is among them for every even
`k ≥ 4`.

For odd `b` the value is not always `0` (`TT□⁷FF = ∗`), and the same method does not reach the
odd positions `T□T□ᵏF□F` with a bounded set of shapes; see `docs/ROW_A2.md`.
-/

namespace Cgt
open Cell TF Game

/-- The finite check, evaluated by the kernel. -/
theorem checkA2Zero : checkAll treeA2Zero = true := by decide +kernel

/-- `T□T□ᵏF□F`. -/
def p0 (k : Nat) : P4 := ⟨true, true, false, false, 0, 1, k, 1, 0⟩

theorem good_p0 (k : Nat) (hk : 4 ≤ k) (he : k % 2 = 0) : good treeA2Zero (p0 k) = true := by
  have hc : cap k = 4 := by
    unfold cap K4
    by_cases h : k < 4 <;> simp only [h, ite_true, ite_false] <;> omega
  have hs : (p0 k).shape = ⟨44, 0, 0, 0, 1, 4⟩ := by
    show (⟨44, 0, 0, cap 0, cap 1, cap k⟩ : Shape) = _
    rw [hc]; rfl
  simp only [good, hs]
  decide

/-- `T□T□ᵏF□F ≤ 0` for even `k ≥ 4`: Right, moving second, wins it. -/
theorem p0_le_zero (k : Nat) (hk : 4 ≤ k) (he : k % 2 = 0) : le (tf (p0 k).toList) zero :=
  le_zero_of_good treeA2Zero checkA2Zero _ (p0 k) (Nat.lt_succ_self _) (good_p0 k hk he)

theorem p0_mem_rms_q2 (k : Nat) : p0 k ∈ (q2 (k + 1)).rms := by
  simp [P4.rms, P4.rm1, P4.rm2, P4.rm3, P4.rm4, q2, p0]

/-- `TT□ᵇFF ≤ 0` for even `b ≥ 6`. -/
theorem start_two_le_zero (k : Nat) (hk : 4 ≤ k) (he : k % 2 = 0) :
    le (tf (start 2 (k + 2))) zero := by
  rw [le_zero_iff_tf, start_two_eq, leftMoves_toList, lms_s2]
  intro q hq
  simp only [List.map_cons, List.map_nil, List.mem_singleton] at hq
  subst hq
  exact ⟨_, toList_mem_rightMoves (p0_mem_rms_q2 k), p0_le_zero k hk he⟩

/-- A symmetric position that is `≤ 0` is `0`. -/
theorem equiv_zero_of_mirror {p : List Cell} (hp : mirror p = p) (h : le (tf p) zero) :
    Equiv (tf p) zero := by
  refine ⟨h, ?_⟩
  have e := tf_mirror p
  rw [hp] at e
  have h' : le zero (neg (tf p)) := by
    rw [← neg_zero, neg_le_neg_iff]; exact h
  exact le_trans _ _ _ h' e.2

/-- **`TT□ᵇFF = 0` for every even `b ≥ 6`.** -/
theorem start_two_equiv_zero (b : Nat) (hb : 6 ≤ b) (he : b % 2 = 0) :
    Equiv (tf (start 2 b)) zero := by
  obtain ⟨k, rfl⟩ : ∃ k, b = k + 2 := ⟨b - 2, by omega⟩
  exact equiv_zero_of_mirror (mirror_start 2 (k + 2)) (start_two_le_zero k (by omega) (by omega))

end Cgt
