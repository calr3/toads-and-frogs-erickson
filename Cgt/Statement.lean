/-!
# The statements: definitions

Everything needed to *state* the main theorems (`Cgt/Conjecture5.lean`), and nothing else: short
games and Conway's order (`Game`, `Game.le`, `Game.lt`, `Game.neg`, `Game.Equiv`), the numbers
`2⁻ⁿ` and infinitesimals (`Game.powHalf`, `Game.Infinitesimal`), the game `∗` (`Game.star`), the
rules of Toads and Frogs (`Cell`, `TF.leftMoves`, `TF.rightMoves`), the game value of a position
(`tf`, with the lemmas its termination proof uses), the starting positions (`start`), Erickson's
Conjecture 5 (`Conjecture5`), the cases left open here (`OpenCases`), and Thanatipanonda's
Conjecture T2 on the exact values of `TT□ᵇFF` (`valueA2`, `ExactValuesA2`).

It uses Lean core only. `Challenge.lean` is a verbatim copy (generated by
`scripts/gen_challenge.py`), so that Comparator can check that the theorems prove these statements
(see `comparator/README.md`). The rest of the theory of these definitions is in `Cgt/Game.lean`,
`Cgt/Infinitesimal.lean` and `Cgt/ToadsFrogs.lean`.
-/

namespace Cgt

/-- A short game, given by its finite lists of Left and Right options. -/
inductive Game where
  | mk : List Game → List Game → Game

namespace Game

theorem sizeOf_lt_of_mem_left {l r : List Game} {x : Game} (h : x ∈ l) :
    sizeOf x < sizeOf (mk l r) := by
  have := List.sizeOf_lt_of_mem h
  simp only [mk.sizeOf_spec]
  omega

theorem sizeOf_lt_of_mem_right {l r : List Game} {x : Game} (h : x ∈ r) :
    sizeOf x < sizeOf (mk l r) := by
  have := List.sizeOf_lt_of_mem h
  simp only [mk.sizeOf_spec]
  omega

/-- The game `0 = { | }`. -/
def zero : Game := mk [] []

/-- Conway's order: `le G H` means `G ≤ H`, i.e. no Left option `Gᴸ` satisfies `H ≤ Gᴸ`
and no Right option `Hᴿ` satisfies `Hᴿ ≤ G`. -/
def le : Game → Game → Prop
  | mk gl gr, mk hl hr =>
      (∀ x : {x // x ∈ gl}, ¬ le (mk hl hr) x.1) ∧ (∀ y : {y // y ∈ hr}, ¬ le y.1 (mk gl gr))
termination_by g h => sizeOf g + sizeOf h
decreasing_by
  · have := sizeOf_lt_of_mem_left (r := gr) x.2
    omega
  · have := sizeOf_lt_of_mem_right (l := hl) y.2
    omega

/-- `lt G H` means `G < H`, i.e. `G ≤ H` and not `H ≤ G`. -/
def lt (g h : Game) : Prop := le g h ∧ ¬ le h g

/-- Game equivalence `G = H` in the sense of combinatorial game theory. -/
def Equiv (g h : Game) : Prop := le g h ∧ le h g

/-- The negative of a game: swap the roles of Left and Right. -/
def neg : Game → Game
  | mk l r => mk (r.attach.map fun y => neg y.1) (l.attach.map fun x => neg x.1)
termination_by g => sizeOf g
decreasing_by
  · exact sizeOf_lt_of_mem_right y.2
  · exact sizeOf_lt_of_mem_left x.2

/-- The dyadic number `2⁻ⁿ`: `powHalf 0 = 1 = {0 | }` and `powHalf (n+1) = {0 | powHalf n}`. -/
def powHalf : Nat → Game
  | 0 => mk [zero] []
  | n + 1 => mk [zero] [powHalf n]

/-- `∗ = {0 | 0}`. -/
def star : Game := mk [zero] [zero]

/-- The integer `n ≥ 0` as a game: `0 = { | }`, `n + 1 = {n | }`. -/
def int : Nat → Game
  | 0 => zero
  | n + 1 => mk [int n] []

/-- `n + 1/2 = {n | n + 1}`. -/
def half (n : Nat) : Game := mk [int n] [int (n + 1)]

/-- `n∗ = {n | n}`. -/
def starN (n : Nat) : Game := mk [int n] [int n]

/-- A game is *infinitesimal* if it lies strictly between `-2⁻ⁿ` and `2⁻ⁿ` for every `n`,
equivalently strictly between `-x` and `x` for every positive (short) number `x`. -/
def Infinitesimal (g : Game) : Prop := ∀ n, lt (neg (powHalf n)) g ∧ lt g (powHalf n)

end Game

/-- A square of the strip. -/
inductive Cell where
  | E  -- empty square `□`
  | T  -- toad (Left)
  | F  -- frog (Right)
  deriving DecidableEq, Repr

open Cell

namespace TF

/-- All positions reachable by one Left (toad) move. -/
def leftMoves : List Cell → List (List Cell)
  | [] => []
  | c :: rest =>
    (match c, rest with
      | T, E :: r => [E :: T :: r]
      | T, F :: E :: r => [E :: F :: T :: r]
      | _, _ => []) ++ (leftMoves rest).map (c :: ·)

/-- All positions reachable by one Right (frog) move. -/
def rightMoves : List Cell → List (List Cell)
  | [] => []
  | c :: rest =>
    (match c, rest with
      | E, F :: r => [F :: E :: r]
      | E, T :: F :: r => [F :: T :: E :: r]
      | _, _ => []) ++ (rightMoves rest).map (c :: ·)

theorem mem_leftMoves {p q : List Cell} :
    q ∈ leftMoves p ↔
      (∃ u r, p = u ++ T :: E :: r ∧ q = u ++ E :: T :: r) ∨
      (∃ u r, p = u ++ T :: F :: E :: r ∧ q = u ++ E :: F :: T :: r) := by
  induction p generalizing q with
  | nil =>
    simp only [leftMoves, List.not_mem_nil, false_iff]
    rintro (⟨u, r, h, -⟩ | ⟨u, r, h, -⟩) <;> cases u <;> simp at h
  | cons c rest ih =>
    simp only [leftMoves, List.mem_append, List.mem_map]
    constructor
    · rintro (h | ⟨q', hq', rfl⟩)
      · match c, rest, h with
        | T, E :: r, h =>
          simp at h; subst h
          exact Or.inl ⟨[], r, rfl, rfl⟩
        | T, F :: E :: r, h =>
          simp at h; subst h
          exact Or.inr ⟨[], r, rfl, rfl⟩
      · rcases ih.1 hq' with ⟨u, r, rfl, rfl⟩ | ⟨u, r, rfl, rfl⟩
        · exact Or.inl ⟨c :: u, r, rfl, rfl⟩
        · exact Or.inr ⟨c :: u, r, rfl, rfl⟩
    · rintro (⟨u, r, hp, rfl⟩ | ⟨u, r, hp, rfl⟩)
      · cases u with
        | nil =>
          simp at hp; obtain ⟨rfl, rfl⟩ := hp
          left; simp
        | cons d u =>
          simp at hp; obtain ⟨rfl, rfl⟩ := hp
          right; exact ⟨u ++ E :: T :: r, ih.2 (Or.inl ⟨u, r, rfl, rfl⟩), rfl⟩
      · cases u with
        | nil =>
          simp at hp; obtain ⟨rfl, rfl⟩ := hp
          left; simp
        | cons d u =>
          simp at hp; obtain ⟨rfl, rfl⟩ := hp
          right; exact ⟨u ++ E :: F :: T :: r, ih.2 (Or.inr ⟨u, r, rfl, rfl⟩), rfl⟩

theorem mem_rightMoves {p q : List Cell} :
    q ∈ rightMoves p ↔
      (∃ u r, p = u ++ E :: F :: r ∧ q = u ++ F :: E :: r) ∨
      (∃ u r, p = u ++ E :: T :: F :: r ∧ q = u ++ F :: T :: E :: r) := by
  induction p generalizing q with
  | nil =>
    simp only [rightMoves, List.not_mem_nil, false_iff]
    rintro (⟨u, r, h, -⟩ | ⟨u, r, h, -⟩) <;> cases u <;> simp at h
  | cons c rest ih =>
    simp only [rightMoves, List.mem_append, List.mem_map]
    constructor
    · rintro (h | ⟨q', hq', rfl⟩)
      · match c, rest, h with
        | E, F :: r, h =>
          simp at h; subst h
          exact Or.inl ⟨[], r, rfl, rfl⟩
        | E, T :: F :: r, h =>
          simp at h; subst h
          exact Or.inr ⟨[], r, rfl, rfl⟩
      · rcases ih.1 hq' with ⟨u, r, rfl, rfl⟩ | ⟨u, r, rfl, rfl⟩
        · exact Or.inl ⟨c :: u, r, rfl, rfl⟩
        · exact Or.inr ⟨c :: u, r, rfl, rfl⟩
    · rintro (⟨u, r, hp, rfl⟩ | ⟨u, r, hp, rfl⟩)
      · cases u with
        | nil =>
          simp at hp; obtain ⟨rfl, rfl⟩ := hp
          left; simp
        | cons d u =>
          simp at hp; obtain ⟨rfl, rfl⟩ := hp
          right; exact ⟨u ++ F :: E :: r, ih.2 (Or.inl ⟨u, r, rfl, rfl⟩), rfl⟩
      · cases u with
        | nil =>
          simp at hp; obtain ⟨rfl, rfl⟩ := hp
          left; simp
        | cons d u =>
          simp at hp; obtain ⟨rfl, rfl⟩ := hp
          right; exact ⟨u ++ F :: T :: E :: r, ih.2 (Or.inr ⟨u, r, rfl, rfl⟩), rfl⟩

/-! ### Termination measure -/

/-- Number of toads in a list. -/
def countT : List Cell → Nat
  | [] => 0
  | c :: r => (if c = T then 1 else 0) + countT r

/-- Number of frogs in a list. -/
def countF : List Cell → Nat
  | [] => 0
  | c :: r => (if c = F then 1 else 0) + countF r

/-- Sum over toads of the number of squares to their right, plus the sum over frogs of
the number of squares to their left. Every move decreases it by exactly one. -/
def pot : List Cell → Nat
  | [] => 0
  | c :: r => (if c = T then r.length else 0) + countF r + pot r

theorem countF_append (u v : List Cell) : countF (u ++ v) = countF u + countF v := by
  induction u with
  | nil => simp [countF]
  | cons c u ih => simp [countF, ih]; omega

theorem pot_append (u v : List Cell) :
    pot (u ++ v) = pot u + pot v + countT u * v.length + countF v * u.length := by
  induction u with
  | nil => simp [pot, countT]
  | cons c u ih =>
    simp only [List.cons_append, pot, List.length_append, countF_append, ih, countT,
      List.length_cons]
    split <;> simp [Nat.add_mul, Nat.mul_add] <;> omega

theorem pot_lt_of_mem_leftMoves {p q : List Cell} (h : q ∈ leftMoves p) : pot q < pot p := by
  rcases mem_leftMoves.1 h with ⟨u, r, rfl, rfl⟩ | ⟨u, r, rfl, rfl⟩
  · rw [pot_append, pot_append]
    simp [pot, countT, countF]
    try omega
  · rw [pot_append, pot_append]
    simp [pot, countT, countF]
    try omega

theorem pot_lt_of_mem_rightMoves {p q : List Cell} (h : q ∈ rightMoves p) :
    pot q < pot p := by
  rcases mem_rightMoves.1 h with ⟨u, r, rfl, rfl⟩ | ⟨u, r, rfl, rfl⟩
  · rw [pot_append, pot_append]
    simp [pot, countT, countF]
    try omega
  · rw [pot_append, pot_append]
    simp [pot, countT, countF]
    try omega

end TF

open TF

/-- The game value of a Toads and Frogs position. -/
def tf (p : List Cell) : Game :=
  Game.mk ((leftMoves p).attach.map fun q => tf q.1) ((rightMoves p).attach.map fun q => tf q.1)
termination_by pot p
decreasing_by
  · exact pot_lt_of_mem_leftMoves q.2
  · exact pot_lt_of_mem_rightMoves q.2

/-- The starting position `Tᵃ □ᵇ Fᵃ`. -/
def start (a b : Nat) : List Cell := List.replicate a T ++ List.replicate b E ++ List.replicate a F

open Game

/-- Erickson's Conjecture 5: `Tᵃ □ᵇ Fᵃ` is infinitesimal unless `(a, b) = (3, 2)`. -/
def Conjecture5 : Prop :=
  ∀ a b : Nat, (a, b) ≠ (3, 2) → Infinitesimal (tf (start a b))

/-- The cases of Conjecture 5 that are not proved here, by proofs checked by the kernel:
`a ≥ 3`, `b ≥ 4` and `2a + b ≥ 13`. (The column `b = 4` is proved separately, with
`native_decide`; see `Cgt/Col/Column4.lean`.) -/
def OpenCases : Prop :=
  ∀ a b : Nat, 3 ≤ a → 4 ≤ b → 13 ≤ 2 * a + b → Infinitesimal (tf (start a b))

/-- The values of `TT□ᵇFF` predicted by Thanatipanonda's Conjecture T2: `∗` if `2 ≤ b ≤ 4` or
`b ≡ 1 (mod 6)`, and `0` otherwise. -/
def valueA2 (b : Nat) : Game := if b = 2 ∨ b = 3 ∨ b = 4 ∨ b % 6 = 1 then star else zero

/-- Thanatipanonda's Conjecture T2: `TT□ᵇFF` equals `valueA2 b` for every `b`. -/
def ExactValuesA2 : Prop := ∀ b : Nat, Equiv (tf (start 2 b)) (valueA2 b)

/-- The position `□ˡ Tᵃ □ᵇ F □ʳ`, with one frog. -/
def oneFrog (l a b r : Nat) : List Cell :=
  List.replicate l E ++ List.replicate a T ++ List.replicate b E ++ F :: List.replicate r E

/-- The values of `□ˡ Tᵃ □ᵇ F □ʳ` (`a ≥ 1`, `l ≤ r`) predicted by Thanatipanonda's Conjecture T1.
With `n = (a - 1)(b - 1 + r)`:

* `r - l ≥ 2`: the integer `(r - l - 1) + n`;
* `l = r - 1`: `n` if `b` is even, `n + 1/2` if `b` is odd;
* `l = r`: `n` if `b` is even, `n∗` if `b` is odd, except `Tᵃ □ F = {{a - 2 | 1} | 0}`
  (`r = 0`, `b = 1`) for `a ≥ 2`.

Subtraction is that of natural numbers, so for `b = r = 0` (the position `Tᵃ F`, where `b - 1 + r`
would be `-1`) the value is `0`. -/
def valueT1 (l a b r : Nat) : Game :=
  if l + 2 ≤ r then int (r - l - 1 + (a - 1) * (b + r - 1))
  else if l + 1 = r then
    if b % 2 = 0 then int ((a - 1) * (b + r - 1)) else half ((a - 1) * (b + r - 1))
  else if b % 2 = 0 then int ((a - 1) * (b + r - 1))
  else if r = 0 ∧ b = 1 ∧ 2 ≤ a then mk [mk [int (a - 2)] [int 1]] [int 0]
  else starN ((a - 1) * (b + r - 1))

/-- Thanatipanonda's Conjecture T1: `□ˡ Tᵃ □ᵇ F □ʳ` equals `valueT1 l a b r` whenever `a ≥ 1` and
`l ≤ r`. -/
def ConjectureT1 : Prop :=
  ∀ l a b r : Nat, 1 ≤ a → l ≤ r → Equiv (tf (oneFrog l a b r)) (valueT1 l a b r)

end Cgt
