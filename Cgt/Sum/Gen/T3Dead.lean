import Cgt.Sum.Rules
import Cgt.Sum.Pure

/-! Library leaves of the plan `T3`, kind Dead (statements generated by `tools/sum/gen.py`). -/

namespace Cgt
namespace Col
open Cell TF Game

/-- The Left moves of a position ending in a dead frog are the slides of the part before it. -/
theorem leftMoves_dead {A B q : List Cell} (hA : F ∉ A) (hB : ∀ c ∈ B, c = T)
    (hq : q ∈ leftMoves (A ++ T :: T :: F :: B)) :
    ∃ A', q = A' ++ T :: T :: F :: B ∧ F ∉ A' ∧ toadMoves A' + 1 = toadMoves A := by
  rcases mem_leftMoves.1 hq with ⟨u, r, hp, rfl⟩ | ⟨u, r, hp, rfl⟩
  · rcases List.append_eq_append_iff.1 hp with ⟨a, rfl, ha⟩ | ⟨c, rfl, hc⟩
    · exfalso
      rcases a with _ | ⟨_, _ | ⟨_, _ | ⟨_, a⟩⟩⟩ <;> simp at ha
      obtain ⟨-, -, -, rfl⟩ := ha
      have := hB E (by simp)
      cases this
    · rcases c with _ | ⟨_, _ | ⟨_, c⟩⟩ <;> simp at hc
      obtain ⟨rfl, rfl, rfl⟩ := hc
      refine ⟨u ++ E :: T :: c, by simp, ?_, toadMoves_slide u c⟩
      simp at hA ⊢
      exact hA
  · exfalso
    rcases List.append_eq_append_iff.1 hp with ⟨a, rfl, ha⟩ | ⟨c, rfl, hc⟩
    · rcases a with _ | ⟨_, _ | ⟨_, _ | ⟨_, a⟩⟩⟩ <;> simp at ha
      · have := hB E (by simp [ha])
        cases this
      · obtain ⟨-, -, -, rfl⟩ := ha
        have := hB E (by simp)
        cases this
    · rcases c with _ | ⟨_, _ | ⟨_, c⟩⟩ <;> simp at hc
      obtain ⟨rfl, rfl, -⟩ := hc
      simp at hA

private theorem tf_dead_aux (B : List Cell) (hB : ∀ c ∈ B, c = T) :
    ∀ (n : Nat) (A : List Cell), F ∉ A → toadMoves A = n →
      le (tf (A ++ T :: T :: F :: B)) (zint (n : Int)) := by
  intro n
  induction n with
  | zero =>
    intro A hA hn
    apply le_zint_of
    · intro x hx
      obtain ⟨q, hq, -⟩ := mem_left_tf.1 hx
      obtain ⟨A', -, -, h⟩ := leftMoves_dead hA hB hq
      omega
    · intro h; omega
  | succ k ih =>
    intro A hA hn
    apply le_zint_of
    · intro x hx
      obtain ⟨q, hq, rfl⟩ := mem_left_tf.1 hx
      obtain ⟨A', rfl, hF, h⟩ := leftMoves_dead hA hB hq
      left
      have e : ((k + 1 : Nat) : Int) - 1 = (k : Int) := by omega
      rw [e]
      exact ih A' hF (by omega)
    · intro h; omega

/-- A frog with two toads directly in front of it and no empty square behind it never moves:
the value is at most the number of moves of the toads in `A`. -/
theorem tf_dead {A B : List Cell} (hA : F ∉ A) (hB : ∀ c ∈ B, c = T) :
    le (tf (A ++ T :: T :: F :: B)) (zint (toadMoves A)) :=
  tf_dead_aux B hB _ A hA rfl

theorem VR_le_of_dead {R : RL} {n : Int} (A B : List Cell)
    (hR : expand R = A ++ T :: T :: F :: B) (hA : F ∉ A) (hB : ∀ c ∈ B, c = T)
    (hn : (toadMoves A : Int) ≤ n) : le (VR R) (zint n) := by
  unfold VR
  rw [hR]
  exact le_trans _ _ _ (tf_dead hA hB) (zint_le_zint hn)

local macro "dead_simp" : tactic =>
  `(tactic| simp [expand, List.replicate_succ, toadMoves_append,
      countE_append, countE_replicate_E, countE_replicate_T,
      toadMoves_replicate_T, toadMoves_replicate_E, countT_replicate_T, countT_replicate_E,
      toadMoves, countE, countT, Nat.add_mul, Nat.mul_add])

/-- ('DEAD',) -/
theorem T3_lib20 (x : Nat) :
    le (VR [(T, x + 1), (E, 1), (T, 3), (F, 1), (T, 1)]) (zint ((x : Int) + 1)) := by
  refine VR_le_of_dead (List.replicate (x + 1) T ++ [E, T]) [T] ?_ ?_ ?_ ?_
  · simp [expand, List.replicate_succ]
  · simp
  · simp
  · (try dead_simp) <;> (try omega)

