import Cgt.Sum.Rules
import Cgt.OneFrog.Upper
import Cgt.OneFrog.Lower
import Cgt.OneFrog.Exception

/-! Library leaves of the plan `T3`, kind Hand (statements generated by `tools/sum/gen.py`). -/

set_option maxRecDepth 4000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace Cgt
namespace Col
open Cell TF Game OneFrog

/-! ### One-frog leaves -/

theorem hand_invL_true_append (k : Nat) (X : List Bool) :
    invL (List.replicate k true ++ X) = invL X := by
  induction k with
  | zero => rfl
  | succ k ih => simpa [List.replicate_succ, invL] using ih

/-- The left side of `Tᵐ □ Tᵏ⁺¹ F`. -/
def handL (k m : Nat) : List Bool := true :: (List.replicate k true ++ false :: List.replicate m true)

theorem handL_stats (k m : Nat) :
    cT (handL k m) = k + 1 + m ∧ room (handL k m) [true, false] = 0 ∧ gap (handL k m) = 0 ∧
      phi (handL k m) [true, false] = m := by
  have h1 : cT (handL k m) = k + 1 + m := by
    simp [handL, cT, cT_append, cT_replicate_true]; omega
  have h2 : cE (handL k m) = 1 := by
    simp [handL, cE, cE_append, cE_replicate_true]
  have h3 : behind (handL k m) = 1 := by
    simp [handL, behind, cE, cE_append, cE_replicate_true]
  have h4 : invL (handL k m) = m := by
    simp [handL, invL, hand_invL_true_append, invL_replicate_true, cT_replicate_true]
  refine ⟨h1, ?_, rfl, ?_⟩
  · unfold room; rw [h3]; simp [cE]
  · unfold phi; rw [h1, h2, h4]; simp [invB, cE]; omega

theorem hand_expand (k m : Nat) :
    expand [(T, m), (E, 1), (T, k + 1), (F, 1), (T, 1), (E, 1)] = pos (handL k m) [true, false] := by
  simp [pos, handL, cell, List.replicate_succ, List.map_replicate, rep_append_cons]

/-- `Tᵐ □ Tᵏ⁺¹ F T □ ≤ m + 1`. -/
theorem hand_upper (k m : Nat) :
    le (VR [(T, m), (E, 1), (T, k + 1), (F, 1), (T, 1), (E, 1)]) (zint ((m : Int) + 1)) := by
  obtain ⟨h1, h2, h3, h4⟩ := handL_stats k m
  have h := (upper_all (handL k m) [true, false]).u4 (by omega) h2 (by omega)
  rw [h4, show ((m : Int) + 1).toNat = m + 1 by omega] at h
  rw [show ((m : Int) + 1) = ((m + 1 : Nat) : Int) by omega, zint_natCast]
  unfold VR; rw [hand_expand]; exact h

/-- `Tᵐ □ Tᵏ⁺¹ F T □ ≥ m + 1`. -/
theorem hand_lower (k m : Nat) :
    le (int (m + 1)) (VR [(T, m), (E, 1), (T, k + 1), (F, 1), (T, 1), (E, 1)]) := by
  obtain ⟨h1, h2, h3, h4⟩ := handL_stats k m
  have h := lower1 (L := handL k m) (B := [true, false]) (n := m + 1) (by omega)
    (Or.inr ⟨h2, by omega⟩) (by omega)
  unfold VR; rw [hand_expand]; exact h

/-- `Tᵐ □ F T □ ≤ m + 1`. -/
theorem hand_upper0 (m : Nat) :
    le (VR [(T, m), (E, 1), (F, 1), (T, 1), (E, 1)]) (zint ((m : Int) + 1)) := by
  have e : expand [(T, m), (E, 1), (F, 1), (T, 1), (E, 1)] =
      pos (false :: List.replicate m true) [true, false] := by
    simp [pos, cell, List.map_replicate]
  have hphi : phi (false :: List.replicate m true) [true, false] = m := by
    unfold phi
    simp [invL, invB, cE, cT, invL_replicate_true, cT_replicate_true, cE_replicate_true]
    omega
  rw [show ((m : Int) + 1) = ((m + 1 : Nat) : Int) by omega, zint_natCast]
  unfold VR; rw [e]
  cases m with
  | zero =>
    have h := (upper_all [false] [true, false]).u0 rfl
    rw [show (phi [false] [true, false]).toNat = 0 by simpa using congrArg Int.toNat hphi] at h
    exact le_trans _ _ _ h (int_le_int (by omega))
  | succ m =>
    have h := (upper_all (false :: List.replicate (m + 1) true) [true, false]).u3
      (by simp [cT, cT_replicate_true])
      (by unfold room; simp [behind, behind_replicate_true, cE])
      (by simp [gap_replicate_true])
    rw [hphi] at h
    exact le_trans _ _ _ h (half_le_int_succ _)

/-- A lower bound for the mirror image is an upper bound. -/
theorem hand_mirror {R : RL} {k : Nat} (h : le (int k) (VR (mirrorRL R))) :
    le (VR R) (zint (-(k : Int))) := by
  unfold VR at *
  rw [expand_mirrorRL] at h
  have h2 := le_trans _ _ _ h (tf_mirror (expand R)).1
  have h3 := (neg_le_neg_iff _ _).2 h2
  rw [neg_neg] at h3
  rw [zint_neg_natCast]; exact h3

/-- `□ F T Fᵏ⁺¹ □ Fᵐ ≤ -(m + 1)`. -/
theorem hand_lowerM (k m : Nat) :
    le (VR [(E, 1), (F, 1), (T, 1), (F, k + 1), (E, 1), (F, m)]) (zint (-(m : Int) - 1)) := by
  have h := hand_mirror (R := [(E, 1), (F, 1), (T, 1), (F, k + 1), (E, 1), (F, m)]) (k := m + 1)
    (by simpa [mirrorRL, Cell.swap] using hand_lower k m)
  exact VR_cast h rfl (congrArg zint (by omega))

theorem VR_congr {R R' : RL} {g : Game} (h : le (VR R') g) (e : expand R = expand R') :
    le (VR R) g := by
  unfold VR at *; rw [e]; exact h

/-! ### Lemma 1 -/

theorem hand1_zero (k : Nat) : le (VR [(E, 1), (T, k + 1), (E, 1), (F, 1)]) (zint 1) := by
  apply VR_le_zint (by simp [maxB, okFrom])
  · intro X hX
    right
    cases k with
    | zero =>
      simp [lmovesR, lmovesAux, moveAt, leftPartRev, rightPart] at hX
      subst hX
      exact ⟨[(E, 1), (F, 1), (T, 1), (E, 1)],
        by simp [rmovesR, mirrorRL, Cell.swap, lmovesR, lmovesAux, moveAt, leftPartRev, rightPart],
        VR_congr (hand_upper0 0) (by simp)⟩
    | succ k =>
      simp [lmovesR, lmovesAux, moveAt, leftPartRev, rightPart] at hX
      subst hX
      exact ⟨[(E, 1), (T, k + 1), (F, 1), (T, 1), (E, 1)],
        by simp [rmovesR, mirrorRL, Cell.swap, lmovesR, lmovesAux, moveAt, leftPartRev, rightPart],
        VR_congr (hand_upper k 0) (by simp)⟩
  · intro h; omega

/-- `Tᵐ⁺¹ □ Tᵏ⁺¹ □ F ≤ m + 2`. -/
theorem hand1 (m : Nat) : ∀ k : Nat,
    le (VR [(T, m + 1), (E, 1), (T, k + 1), (E, 1), (F, 1)]) (zint ((m : Int) + 2)) := by
  induction m with
  | zero =>
    intro k
    apply VR_le_zint (by simp [maxB, okFrom])
    · intro X hX
      cases k with
      | zero =>
        simp [lmovesR, lmovesAux, moveAt, leftPartRev, rightPart] at hX
        rcases hX with rfl | rfl
        · exact Or.inl (hand1_zero 1)
        · exact Or.inr ⟨[(T, 1), (E, 1), (F, 1), (T, 1), (E, 1)],
            by simp [rmovesR, mirrorRL, Cell.swap, lmovesR, lmovesAux, moveAt, leftPartRev, rightPart],
            hand_upper0 1⟩
      | succ k =>
        simp [lmovesR, lmovesAux, moveAt, leftPartRev, rightPart] at hX
        rcases hX with rfl | rfl
        · exact Or.inl (hand1_zero (k + 2))
        · exact Or.inr ⟨[(T, 1), (E, 1), (T, k + 1), (F, 1), (T, 1), (E, 1)],
            by simp [rmovesR, mirrorRL, Cell.swap, lmovesR, lmovesAux, moveAt, leftPartRev, rightPart],
            hand_upper k 1⟩
    · intro h; omega
  | succ m ih =>
    intro k
    apply VR_le_zint (by simp [maxB, okFrom])
    · intro X hX
      cases k with
      | zero =>
        simp [lmovesR, lmovesAux, moveAt, leftPartRev, rightPart] at hX
        rcases hX with rfl | rfl
        · exact Or.inl (VR_cast (ih 1) rfl (congrArg zint (by omega)))
        · exact Or.inr ⟨[(T, m + 2), (E, 1), (F, 1), (T, 1), (E, 1)],
            by simp [rmovesR, mirrorRL, Cell.swap, lmovesR, lmovesAux, moveAt, leftPartRev, rightPart],
            VR_cast (hand_upper0 (m + 2)) rfl (congrArg zint (by omega))⟩
      | succ k =>
        simp [lmovesR, lmovesAux, moveAt, leftPartRev, rightPart] at hX
        rcases hX with rfl | rfl
        · exact Or.inl (VR_cast (ih (k + 2)) rfl (congrArg zint (by omega)))
        · exact Or.inr ⟨[(T, m + 2), (E, 1), (T, k + 1), (F, 1), (T, 1), (E, 1)],
            by simp [rmovesR, mirrorRL, Cell.swap, lmovesR, lmovesAux, moveAt, leftPartRev, rightPart],
            VR_cast (hand_upper k (m + 2)) rfl (congrArg zint (by omega))⟩
    · intro h; omega

/-- ('NEED',) -/
theorem T3_lib1 (x : Nat) :
    le (VR [(T, x + 1), (E, 1), (T, 4), (E, 1), (F, 1)]) (zint ((x : Int) + 2)) :=
  hand1 x 3

/-! ### Lemma 2 -/

/-- `T F □ Fᵇ⁺¹ □ ≤ 0`. -/
theorem hand2_zero (b : Nat) : le (VR [(T, 1), (F, 1), (E, 1), (F, b + 1), (E, 1)]) (zint 0) := by
  apply VR_le_zint (by simp [maxB, okFrom])
  · intro X hX
    simp [lmovesR, lmovesAux, moveAt, leftPartRev, rightPart] at hX
    subst hX
    exact Or.inl (VR_congr (hand_lowerM b 0) (by simp))
  · intro h; omega

/-- `T F □ Fᵇ⁺¹ □ Fᵃ⁺¹ ≤ -(a + 1)`. -/
theorem hand2 (a : Nat) : ∀ b : Nat,
    le (VR [(T, 1), (F, 1), (E, 1), (F, b + 1), (E, 1), (F, a + 1)]) (zint (-(a : Int) - 1)) := by
  induction a with
  | zero =>
    intro b
    apply VR_le_zint (by simp [maxB, okFrom])
    · intro X hX
      simp [lmovesR, lmovesAux, moveAt, leftPartRev, rightPart] at hX
      subst hX
      exact Or.inl (VR_cast (hand_lowerM b 1) rfl (congrArg zint (by omega)))
    · intro _
      exact ⟨[(T, 1), (F, 1), (E, 1), (F, b + 2), (E, 1)],
        by simp [rmovesR, mirrorRL, Cell.swap, lmovesR, lmovesAux, moveAt, leftPartRev, rightPart],
        VR_cast (hand2_zero (b + 1)) rfl (congrArg zint (by omega))⟩
  | succ a ih =>
    intro b
    apply VR_le_zint (by simp [maxB, okFrom])
    · intro X hX
      simp [lmovesR, lmovesAux, moveAt, leftPartRev, rightPart] at hX
      subst hX
      exact Or.inl (VR_cast (hand_lowerM b (a + 2)) rfl (congrArg zint (by omega)))
    · intro _
      exact ⟨[(T, 1), (F, 1), (E, 1), (F, b + 2), (E, 1), (F, a + 1)],
        by simp [rmovesR, mirrorRL, Cell.swap, lmovesR, lmovesAux, moveAt, leftPartRev, rightPart],
        VR_cast (ih (b + 1)) rfl (congrArg zint (by omega))⟩

/-- ('NEED',) -/
theorem T3_lib10 (y : Nat) :
    le (VR [(T, 1), (F, 1), (E, 2), (F, y + 2)]) (zint ( - (y : Int) - 2)) := by
  apply VR_le_zint (by simp [maxB, okFrom])
  · intro X hX
    simp [lmovesR, lmovesAux, moveAt, leftPartRev, rightPart] at hX
    subst hX
    exact Or.inr ⟨[(E, 1), (F, 1), (T, 1), (F, 1), (E, 1), (F, y + 1)],
      by simp [rmovesR, mirrorRL, Cell.swap, lmovesR, lmovesAux, moveAt, leftPartRev, rightPart],
      VR_cast (hand_lowerM 0 (y + 1)) rfl (congrArg zint (by omega))⟩
  · intro _
    exact ⟨[(T, 1), (F, 1), (E, 1), (F, 1), (E, 1), (F, y + 1)],
      by simp [rmovesR, mirrorRL, Cell.swap, lmovesR, lmovesAux, moveAt, leftPartRev, rightPart],
      VR_cast (hand2 y 0) rfl (congrArg zint (by omega))⟩

