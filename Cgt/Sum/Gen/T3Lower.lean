import Cgt.Sum.Rules
import Cgt.OneFrog.Lower
import Cgt.OneFrog.T1
import Cgt.OneFrog.Exception

/-! Library leaves of the plan `T3`, kind Lower (statements generated by `tools/sum/gen.py`). -/

namespace Cgt
namespace Col
open Cell TF Game

theorem le_neg_of_mirror {p : List Cell} {k : Int} (h : le (zint k) (tf (mirror p))) :
    le (tf p) (zint (-k)) := by
  have h1 : le (zint k) (neg (tf p)) := le_trans _ _ _ h (tf_mirror p).1
  have h2 : zint k = neg (zint (-k)) := by rw [neg_zint, Int.neg_neg]
  rw [h2] at h1
  exact (neg_le_neg_iff _ _).1 h1

/-- A one-toad run list is bounded above via a lower bound for its one-frog mirror image. -/
theorem VR_le_of_mirror {R : RL} {L B : List Bool} {n : Nat} {m : Int}
    (hp : mirror (expand R) = OneFrog.pos L B) (h : le (int n) (OneFrog.V L B))
    (hm : m = -(n : Int)) : le (VR R) (zint m) := by
  subst hm
  apply le_neg_of_mirror
  rw [hp, zint_natCast]
  exact h

section
open OneFrog

local macro "mir" : tactic =>
  `(tactic| simp [expand, mirror_replicate, pos, cell, List.replicate_succ, List.map_replicate,
      List.reverse_replicate])
local macro "stats" : tactic =>
  `(tactic| simp [phi, room, invL, invB, cT, cE, behind, gap, cT_replicate_true,
      cE_replicate_true, invL_replicate_true, gap_replicate_true, behind_replicate_true])

theorem T3L_a (y : Nat) :
    le (VR [(T, 1), (E, 2), (F, y + 2)]) (zint ( - (y : Int) - 1)) := by
  refine VR_le_of_mirror (L := false :: false :: List.replicate (y + 2) true) (B := [])
    (n := y + 1) (by mir) (lower1 (by stats) (Or.inr ⟨by stats, by stats⟩) ?_) (by omega)
  stats; omega

theorem T3L_b (y : Nat) :
    le (VR [(E, 2), (T, 1), (F, y + 2)]) (zint ( - (y : Int) - 2)) := by
  refine VR_le_of_mirror (L := List.replicate (y + 2) true) (B := [false, false])
    (n := y + 2) (by mir) (int_le_V_of_le_phi ?_) (by omega)
  stats; omega

/-- `E F T F E F^k`, `k ≥ 0`. -/
theorem T3L_c (k : Nat) :
    le (VR [(E, 1), (F, 1), (T, 1), (F, 1), (E, 1), (F, k)]) (zint ( - (k : Int) - 1)) := by
  refine VR_le_of_mirror (L := true :: false :: List.replicate k true) (B := [true, false])
    (n := k + 1) (by mir) (lower1 (by stats) (Or.inr ⟨by stats, by stats⟩) ?_) (by omega)
  stats; omega

/-- `E T F E F^k`, `k ≥ 1`. -/
theorem T3L_d (k : Nat) :
    le (VR [(E, 1), (T, 1), (F, 1), (E, 1), (F, k + 1)]) (zint ( - (k : Int) - 1)) := by
  refine VR_le_of_mirror (L := true :: false :: List.replicate (k + 1) true) (B := [false])
    (n := k + 1) (by mir) (lower1 (by stats) (Or.inr ⟨by stats, by stats⟩) ?_) (by omega)
  stats; omega

end

/-- ('T1L', 'lower1') -/
theorem T3_lib12 (y : Nat) :
    le (VR [(T, 1), (E, 2), (F, y + 2)]) (zint ( - (y : Int) - 1)) := by
  exact T3L_a y

/-- ('T1L', 'lower0') -/
theorem T3_lib13 (y : Nat) :
    le (VR [(E, 2), (T, 1), (F, y + 2)]) (zint ( - (y : Int) - 2)) := by
  exact T3L_b y

/-- ('T1L', 'lower1') -/
theorem T3_lib18 (y : Nat) :
    le (VR [(E, 1), (F, 1), (T, 1), (F, 1), (E, 1), (F, y + 1)]) (zint ( - (y : Int) - 2)) := by
  have h := T3L_c (y + 1)
  exact VR_le_zint_mono h (by omega)

/-- ('T1L', 'lower1') -/
theorem T3_lib22 (y : Nat) :
    le (VR [(E, 1), (T, 1), (F, 1), (E, 1), (F, y + 2)]) (zint ( - (y : Int) - 2)) := by
  have h := T3L_d (y + 1)
  exact VR_le_zint_mono h (by omega)

/-- ('T1L', 'lower0') -/
theorem T3_lib27 (y : Nat) :
    le (VR [(E, 1), (T, 1), (E, 1), (F, y + 2)]) (zint ( - (y : Int) - 1)) := by
  refine VR_le_of_mirror (L := false :: List.replicate (y + 2) true) (B := [false])
    (n := y + 1) (by simp [expand, mirror_replicate, OneFrog.pos, OneFrog.cell, List.replicate_succ, List.map_replicate, List.reverse_replicate]) (OneFrog.int_le_V_of_le_phi ?_) (by omega)
  simp [OneFrog.phi, OneFrog.invL, OneFrog.invB, OneFrog.cT, OneFrog.cE, OneFrog.cT_replicate_true,
    OneFrog.cE_replicate_true, OneFrog.invL_replicate_true]
  omega

/-- ('T1L', 'lower1') -/
theorem T3_lib55 :
    le (VR [(T, 1), (E, 2), (F, 2)]) (zint ((-1 : Int))) := by
  exact T3L_a 0

/-- ('T1L', 'lower0') -/
theorem T3_lib56 :
    le (VR [(E, 2), (T, 1), (F, 2)]) (zint ((-2 : Int))) := by
