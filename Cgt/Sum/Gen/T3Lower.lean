theorem T3_lib64 (h0 : (-1 : Int) < 0) :
    le (VR [(E, 1), (F, 1), (T, 1), (F, 1), (E, 1)]) (zint ((-1 : Int))) := by
  have h := T3L_c 0
  exact VR_le_zint_mono h (by decide)

/-- ('T1L', 'lower1') -/
theorem T3_lib67 :
    le (VR [(E, 1), (T, 1), (F, 1), (E, 1), (F, 1)]) (zint ((-1 : Int))) := by
  exact T3L_d 0

