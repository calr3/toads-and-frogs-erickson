theorem VR_le_of_noF {R : RL} {n : Int} (h : F ∉ expand R)
    (hn : (toadMoves (expand R) : Int) ≤ n) : le (VR R) (zint n) :=
  le_trans _ _ _ (tf_noF h).1 (zint_le_zint hn)

theorem VR_le_of_noT {R : RL} {n : Int} (h : T ∉ expand R)
    (hn : -(toadMoves (mirror (expand R)) : Int) ≤ n) : le (VR R) (zint n) :=
  le_trans _ _ _ (tf_noT h).1 (zint_le_zint hn)

local macro "pure_simp" : tactic =>
  `(tactic| simp [expand, mirror_append, mirror_replicate, Cell.swap, toadMoves_append,
      countE_append, countE_replicate_E, countE_replicate_T, countE_replicate_F,
      toadMoves_replicate_T, toadMoves_replicate_E, countT_replicate_T, countT_replicate_E,
      toadMoves, countE, countT, Nat.add_mul, Nat.mul_add])

local macro "pure_noF" : tactic =>
  `(tactic| (refine VR_le_of_noF (by simp [expand]) ?_; (try pure_simp) <;> (try omega)))

local macro "pure_noT" : tactic =>
  `(tactic| (refine VR_le_of_noT (by simp [expand]) ?_; (try pure_simp) <;> (try omega)))

