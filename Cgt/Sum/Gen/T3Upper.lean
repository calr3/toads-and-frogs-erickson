open Cell TF Game OneFrog

theorem pos_append_replicate_true (L B : List Bool) (n : Nat) :
    pos (L ++ List.replicate n true) B = List.replicate n T ++ pos L B := by
  simp [pos, cell, List.map_append, List.map_replicate, List.reverse_append,
    List.reverse_replicate]

theorem VR_le_of_pos {R : RL} {L B : List Bool} {k : Nat} {n : Int} (h : expand R = pos L B)
    (hV : le (V L B) (int k)) (hn : (k : Int) ≤ n) : le (VR R) (zint n) := by
  have h1 : le (VR R) (zint (k : Int)) := by
    rw [zint_natCast]; unfold VR; rw [h]; exact hV
  exact le_trans _ _ _ h1 (zint_le_zint hn)

/-- Evaluate the statistics of an explicit one-frog position and close the linear goal. -/
macro "of_stat" : tactic =>
  `(tactic| first
    | (simp [room, phi, cT, cE, invL, invB, gap, behind, cT_replicate_true, cE_replicate_true,
        invL_replicate_true, gap_replicate_true, behind_replicate_true]; done)
    | (simp [room, phi, cT, cE, invL, invB, gap, behind, cT_replicate_true, cE_replicate_true,
        invL_replicate_true, gap_replicate_true, behind_replicate_true]; omega)
    | omega)

/-- ('T1U', 'u4') -/
theorem T3_lib3 (x : Nat) :
    le (VR [(T, x + 1), (E, 1), (T, 3), (F, 1), (T, 1), (E, 1)]) (zint ((x : Int) + 2)) := by
  have h : expand [(T, x + 1), (E, 1), (T, 3), (F, 1), (T, 1), (E, 1)] =
      pos ([true, true, true, false] ++ List.replicate (x + 1) true) [true, false] := by
    rw [pos_append_replicate_true]; rfl
  refine VR_le_of_pos h ((upper_all _ _).u4 ?_ ?_ ?_) ?_ <;> of_stat

