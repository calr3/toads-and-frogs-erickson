import Cgt.Col.Check
import Std.Data.HashSet
/-!
Generator for the column data: reads `MODE CELLS` lines (one witness position per shape, from
`tools/column/to_witness.py`), computes the Lean keys, and checks the closure with exactly the
definitions of `Cgt/Col/Key.lean`.

Usage: lake env lean --run scripts/ColGen.lean WITNESSES [OUT.lean NAME]
(with OUT.lean: write the keys as two search trees `NAMEU`, `NAMEN`)
-/
open Cgt Cgt.Col Cell

def parseCells (s : String) : List Cell :=
  s.toList.map fun c => if c == 'T' then T else if c == 'F' then F else E

def rle : List Cell → RL
  | [] => []
  | c :: l => match rle l with
    | (d, n) :: R => if c = d then (d, n + 1) :: R else (c, 1) :: (d, n) :: R
    | [] => [(c, 1)]

def treeTerm (a : Array (List Nat)) (lo hi : Nat) : String :=
  if lo ≥ hi then "LTree.leaf"
  else
    let mid := (lo + hi) / 2
    s!"(LTree.node {treeTerm a lo mid} {a[mid]!} {treeTerm a (mid + 1) hi})"
termination_by hi - lo

def emitTree (name : String) (keys : List (List Nat)) : String :=
  let a := keys.toArray.qsort (fun x y => lexLt x y)
  s!"set_option maxRecDepth 100000 in\n/-- {a.size} keys. -/\ndef {name} : LTree :=\n  {treeTerm a 0 a.size}\n"

def lfOKs (U N : Std.HashSet (List Nat)) (Y : RL) : Bool :=
  N.contains (keyOf Y) || (rmovesR Y).any fun Z => U.contains (keyOf Z)

def main (args : List String) : IO Unit := do
  let file := args.headD ""
  let lines ← IO.FS.lines file
  let mut U : Std.HashSet (List Nat) := {}
  let mut N : Std.HashSet (List Nat) := {}
  for l in lines do
    let parts := l.splitOn " "
    if parts.length < 2 then continue
    let R := rle (parseCells parts[1]!)
    if parts[0]! == "U" then U := U.insert (keyOf R) else N := N.insert (keyOf R)
  IO.println s!"{U.size} U keys, {N.size} N keys"
  let mut bad := 0
  let mut nw := 0
  let mut nm := 0
  for k in U.toList do
    for W in witOf k do
      nw := nw + 1
      let ms := lmovesR W
      nm := nm + ms.length + 1
      unless lfOKs U N W && ms.all (lfOKs U N) do
        bad := bad + 1
        if bad ≤ 5 then IO.println s!"U fail {k} at {repr W}"
  for k in N.toList do
    for W in witOf k do
      nw := nw + 1
      let ms := lmovesR W
      nm := nm + ms.length
      unless ms.all (fun X => (rmovesR X).any fun Z => N.contains (keyOf Z)) do
        bad := bad + 1
        if bad ≤ 5 then IO.println s!"N fail {k} at {repr W}"
  IO.println s!"{nw} witnesses, {nm} Left moves and passes, {bad} failures"
  let mut miss := 0
  for a in List.range 40 do
    if a ≥ 2 then
      unless U.contains (keyOf [(T, a), (E, 3), (F, a)]) do miss := miss + 1
  IO.println s!"start shapes missing for a = 2..39: {miss}"
  if args.length ≥ 3 then
    let out := args[1]!
    let name := args[2]!
    let body := "import Cgt.Col.Check\n\n/-! Machine-generated by `scripts/ColGen.lean`: the keys of the column certificate. -/\n\n" ++
      "namespace Cgt\nnamespace Col\n\n" ++ emitTree (name ++ "U") U.toList ++ "\n" ++ emitTree (name ++ "N") N.toList ++
      "\nend Col\nend Cgt\n"
    IO.FS.writeFile out body
    IO.println s!"wrote {out}"
